# Pins the dev Grafana version so `npm run server` (docker-compose) runs the same
# Grafana that grafana-beta runs. Grafana's frontend components (e.g. Combobox)
# differ between majors, so validating on a different version can hide real bugs.
#
# Keep this file TRACKED (do not add it to .gitignore) — it is the shared default,
# not a per-developer secret. Override per-run with `GRAFANA_VERSION=x npm run server`.
# Check beta's version with `curl -s https://grafana-beta.vtex.com/api/health` and
# bump this when it changes.
GRAFANA_VERSION=12.0.1
