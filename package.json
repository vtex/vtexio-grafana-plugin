{
  "name": "vtexio-grafana-plugin",
  "version": "0.3.2-beta.0",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend --",
    "build:ci": "npm run build && apt-get install -y zip && npm run package",
    "package": "rm -rf vtexio-grafana-plugin-build && mkdir -p vtexio-grafana-plugin-build/vtex-grafana-datasource && cp -r dist/* vtexio-grafana-plugin-build/vtex-grafana-datasource/ && cd vtexio-grafana-plugin-build && zip -r vtex-grafana-datasource-$npm_package_version.zip vtex-grafana-datasource && rm -rf vtex-grafana-datasource",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "test:single": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "clean": "rm -rf grafana-plugins/ vtexio-grafana-plugin-build/",
    "clean:all": "rm -rf dist/* grafana-plugins/ vtexio-grafana-plugin-build/ && mkdir -p dist",
    "prebuild": "npm run clean",
    "preserver": "npm run build:backend:local",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest --rootUrls https://grafana.com,https://vtexioapps.grafana.net,https://grafana-beta.vtex.com,http://localhost:3000",
    "build:backend": "go run github.com/magefile/mage@latest -v buildAll",
    "build:backend:local": "go run github.com/magefile/mage@latest -v build:linux build:linuxARM64",
    "build:frontend": "webpack -c ./.config/webpack/webpack.config.ts --env production"
  },
  "author": "VTEX",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^8.0.0",
    "@grafana/plugin-e2e": "^3.7.1",
    "@grafana/tsconfig": "^2.0.0",
    "@playwright/test": "^1.52.0",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.8.7",
    "@types/string-format": "^2.0.3",
    "@types/testing-library__jest-dom": "5.14.8",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.7.3",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-jsdoc": "^46.8.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-webpack-plugin": "^4.0.1",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.5.0",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "semver": "^7.6.3",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.6.1",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "^11.5.3",
    "@grafana/runtime": "^11.5.3",
    "@grafana/schema": "^11.5.3",
    "@grafana/ui": "^11.5.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "string-format": "^2.0.0"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "@grafana/plugin-e2e": {
      "@grafana/e2e-selectors": "13.2.0-30866084945"
    },
    "websocket-driver": "0.7.5",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "fast-uri": "3.1.6",
    "js-yaml@3": "3.15.1",
    "js-yaml@4": "4.3.1",
    "minimatch@9": "9.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
